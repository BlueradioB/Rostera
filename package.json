{
  "name": "rostera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vercel-build": "npm run build && node scripts/build-vercel.mjs",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:vercel": "npx vercel dev",
    "test": "npm run build && node --test dist/src/test/*.test.js",
    "backup": "npm run build && node dist/src/backup.js",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0"
  }
}
